{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:khannaoffice:system:v1:schema:grant",
  "title": "Grant",
  "description": "SPEC 18.1. One principal's delegation to one actor: scopes, resources, origins, expiry, revocation. Least privilege: nothing is granted that is not listed.",
  "type": "object",
  "required": [
    "id",
    "principal",
    "actor",
    "scopes",
    "resources",
    "grantedAt",
    "expiresAt"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "principal": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "origins": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "grantedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "revokedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
